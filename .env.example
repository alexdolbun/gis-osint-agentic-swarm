# Copy to .env and fill in only what you actually use.
# Nothing here is required for --offline / --demo runs.

# ── swarm run shape ──────────────────────────────────────────────────────────
SWARM_MODE=demo                 # demo | live
SWARM_CITIES=6
SWARM_CONCURRENCY=8
SWARM_RATE_PER_MIN=120
SWARM_OUT=out

# ── auth swarm (server-side ID-token verification) ───────────────────────────
# The audience is the OAuth client id of the provider you verify for.
GOOGLE_CLIENT_ID=
GOOGLE_HOSTED_DOMAIN=           # optional: restrict to a Workspace domain (hd)
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT=common         # or a tenant id / verified domain
HUAWEI_CLIENT_ID=

# ── edge worker (wrangler) ───────────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=
GIS_KV_NAMESPACE_ID=            # optional KV binding for run-state snapshots

# ── premium alpha feed (x402) ────────────────────────────────────────────────
X402_PAY_TO=                    # receiving address for the $99/mo alpha feed
X402_PRICE_USD=99
